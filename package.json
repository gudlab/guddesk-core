{
  "name": "guddesk",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "GudDesk",
    "url": "https://guddesk.com"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "contentlayer2 build && next dev --turbo",
    "build:content": "contentlayer2 build",
    "build:widget": "cd packages/widget && pnpm install && pnpm run build && cp dist/guddesk.umd.cjs ../../public/widget.js",
    "build": "pnpm run build:widget && pnpm run build:content && next build",
    "turbo": "next dev --turbo",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit && pnpm --dir packages/widget typecheck",
    "preview": "next build && next start",
    "postinstall": "prisma generate",
    "email": "email dev --dir emails --port 3333",
    "remove-content": "node ./setup.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs"
  },
