# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL - Neon)
# -----------------------------------------------------------------------------
DATABASE_URL='postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require'

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Sender for invites, password resets, sign-in links and notifications, on a
# domain verified in Resend. Default: GudDesk <notifications@guddesk.com>.
# Self-hosting: set this to your own domain, e.g. GudDesk <support@yourdomain.com>.
# RESEND_FROM=
# Signing secret (whsec_...) of the Resend webhook for received emails,
# pointed at /api/email/inbound. Without it the route refuses every
# request, so inbound email (customer emails and agent replies by email)
# is off. Inbound also needs RESEND_API_KEY to be a full-access key: the
# webhook only carries the email's id and the body is fetched with the
# key. A sending-only key makes every inbound email fail (500).
RESEND_WEBHOOK_SECRET=
# Email is not sent under NODE_ENV=development (pnpm dev). Set to 1 to send anyway.
# EMAIL_SEND_IN_DEV=1

# -----------------------------------------------------------------------------
# Pusher (real-time messaging) - optional
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# -----------------------------------------------------------------------------
# Stripe (payments) - optional
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Anthropic (AI features) - optional
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Slack integration - optional
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft Clarity (analytics) - optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Bearer token for /api/cron/* (Authorization: Bearer <CRON_SECRET>).
# Without it every cron route returns 401. Generate with: openssl rand -hex 32
CRON_SECRET=
