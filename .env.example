# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL - Neon)
# -----------------------------------------------------------------------------
DATABASE_URL='postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require'

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Pusher (real-time messaging) - optional
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# -----------------------------------------------------------------------------
# Stripe (payments) - optional locally; required for Preview seed
# Use test-mode keys only (sk_test_ / pk_test_). Live keys are refused.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Preview QA seed (`pnpm db:seed:preview`) - never commit real values
# Set these on the Vercel Preview environment (not Production).
# Preview may receive XSS test payloads. Never point the seed at production.
# Passwords and PREVIEW_WORKSPACE_A_IDENTITY_SECRET stay in env only.
# -----------------------------------------------------------------------------
PREVIEW_SEED=
# The seed connects only to PREVIEW_DATABASE_URL (never DATABASE_URL) and
# refuses a database that holds any workspace not starting with preview-.
PREVIEW_DATABASE_URL=
# Required. Compared with PREVIEW_DATABASE_URL, never connected to.
# Both URLs must name the database and must not set host, hostaddr, port,
# dbname, database, db, user, or options in the query string.
PRODUCTION_DATABASE_URL=
PREVIEW_OWNER_A_PASSWORD=
PREVIEW_OWNER_B_PASSWORD=
PREVIEW_AGENT_A_PASSWORD=
PREVIEW_AGENT_B_PASSWORD=
PREVIEW_WORKSPACE_A_IDENTITY_SECRET=
# Optional overrides (defaults: qa-owner-a@guddesk.test, qa-owner-b@guddesk.test,
# qa-agent-a@guddesk.test, qa-agent-b@guddesk.test, slugs preview-a / preview-b).
# Emails must end in @guddesk.test and slugs must start with preview-.
# PREVIEW_OWNER_A_EMAIL=
# PREVIEW_OWNER_B_EMAIL=
# PREVIEW_AGENT_A_EMAIL=
# PREVIEW_AGENT_B_EMAIL=
# PREVIEW_WORKSPACE_A_SLUG=
# PREVIEW_WORKSPACE_B_SLUG=
# Shared fallback if per-workspace agent passwords are unset:
# PREVIEW_AGENT_PASSWORD=

# -----------------------------------------------------------------------------
# Anthropic (AI features) - optional
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Slack integration - optional
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft Clarity (analytics) - optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Env validation skip - MCP stdio server only
# -----------------------------------------------------------------------------
# bin/guddesk-mcp.ts sets SKIP_ENV_VALIDATION=1 itself so it can run with only
# DATABASE_URL and GUDDESK_API_KEY. Do not set it here or in any deployed
# environment. It is ignored on Vercel and when NODE_ENV=production.
# SKIP_ENV_VALIDATION=

# Bearer token for /api/cron/* (Authorization: Bearer <CRON_SECRET>).
# Without it every cron route returns 401. Generate with: openssl rand -hex 32
CRON_SECRET=
