// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum ConversationStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum ConversationChannel {
  WIDGET
  EMAIL
  API
}

enum SurveyType {
  CSAT
  NPS
}

enum SurveyTriggerType {
  ON_CLOSE
  AFTER_DELAY
}

enum MessageType {
  VISITOR
  AGENT
  NOTE
  SYSTEM
  BOT
}

enum AgentAvailability {
  ONLINE
  AWAY
  OFFLINE
}

enum ApiKeyPermission {
  READ_ONLY
  READ_WRITE
  FULL_ACCESS
}

// ─── Auth Models ─────────────────────────────────────────

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @default(now()) @map(name: "updated_at")
  role          UserRole  @default(USER)
  isBanned      Boolean   @default(false)
  bannedAt      DateTime?

  accounts             Account[]
  sessions             Session[]
  workspaceMembers     WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[]
  messages             Message[]
  articles             Article[]
  apiKeys              ApiKey[]
  adminAuditLogs       AdminAuditLog[]

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires    DateTime

  @@unique([email, token])
  @@map(name: "password_reset_tokens")
}

// ─── Workspace & Organization Models ────────────────────

model Workspace {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  logo                 String?
  plan                 SubscriptionPlan @default(FREE)
  appId                String           @unique @default(cuid())
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  createdAt            DateTime         @default(now()) @map(name: "created_at")
  updatedAt            DateTime         @updatedAt @map(name: "updated_at")

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  conversations      Conversation[]
  visitors           Visitor[]
  articles           Article[]
  collections        Collection[]
  widgetSettings     WidgetSettings?
  helpCenterSettings HelpCenterSettings?
  cannedResponses    CannedResponse[]
  aiUsageLogs        AiUsageLog[]
  automationRules    AutomationRule[]
  agents             Agent[]
  webhookEndpoints   WebhookEndpoint[]
  apiKeys            ApiKey[]
  slackIntegration   SlackIntegration?
  analyticsSnapshots AnalyticsSnapshot[]
  companies          Company[]
  customFields       CustomField[]
  customerEvents     CustomerEvent[]
  customerSegments   CustomerSegment[]
  slaPolicies        SlaPolicy[]
  businessHours      BusinessHours?
  ticketForms        TicketForm[]
  surveyConfigs               SurveyConfig[]
  surveyResponses             SurveyResponse[]
  emailChannelConfig          EmailChannelConfig?
  agentPerformanceSnapshots   AgentPerformanceSnapshot[]
  sideConversations           SideConversation[]
  automationRuns              AutomationRun[]

  @@map(name: "workspaces")
}

model WorkspaceMember {
  id               String            @id @default(cuid())
  workspaceId      String
  userId           String
  role             WorkspaceRole     @default(AGENT)
  availability     AgentAvailability @default(OFFLINE)
  lastActiveAt     DateTime?
  currentViewingId String?           // conversationId currently viewing (collision detection)
  createdAt        DateTime          @default(now()) @map(name: "created_at")
  updatedAt        DateTime          @updatedAt @map(name: "updated_at")

  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map(name: "workspace_members")
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(AGENT)
  status      InvitationStatus @default(PENDING)
  token       String           @unique @default(cuid())
  expiresAt   DateTime
  invitedById String
  createdAt   DateTime         @default(now()) @map(name: "created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map(name: "workspace_invitations")
}

// ─── Widget Settings ─────────────────────────────────────

model WidgetSettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  primaryColor     String   @default("#3ECF8E")
  position         String   @default("bottom-right")
  welcomeMessage   String   @default("Hi! How can we help you?")
  workspaceName    String?
  workspaceAvatarUrl String?
  showBranding     Boolean  @default(true)
  requireEmail     Boolean  @default(false)
  suggestArticles    Boolean  @default(true)
  offlineFormTimeout Int?     @map(name: "offline_form_timeout") // minutes — null means disabled
  pageVisibilityMode    String @default("exclude") // "exclude" or "include"
  pageVisibilityPatterns Json   @default("[]")      // JSON array of glob-pattern strings
  identitySecret     String?                        // HMAC-SHA256 secret for identity verification
  createdAt          DateTime @default(now()) @map(name: "created_at")
  updatedAt          DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map(name: "widget_settings")
}

// ─── Visitor & Conversation Models ───────────────────────

model Visitor {
  id         String   @id @default(cuid())
  workspaceId String
  companyId  String?
  externalId String?
  name       String?
  email      String?
  avatarUrl  String?
  metadata   Json?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now()) @map(name: "created_at")
  updatedAt  DateTime @updatedAt @map(name: "updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  customerEvents CustomerEvent[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([companyId])
  @@map(name: "visitors")
}

model Conversation {
  id                 String              @id @default(cuid())
  workspaceId        String
  visitorId          String
  assigneeId         String?
  status             ConversationStatus  @default(OPEN)
  channel            ConversationChannel @default(WIDGET)
  subject            String?
  priority           Int                 @default(0)
  tags               String[]
  snoozedUntil       DateTime?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  aiSummary          String?
  metadata           Json?
  createdAt          DateTime            @default(now()) @map(name: "created_at")
  updatedAt          DateTime            @updatedAt @map(name: "updated_at")
  closedAt           DateTime?
  unassignedAt       DateTime? // Since when it has had no assignee: set at creation and on every unassign. Null on rows from before this column; the "unassigned for" job skips those.

  // SLA tracking
  slaPolicyId        String?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstResponseAt    DateTime?
  slaBreachedAt      DateTime?

  // Ticket forms
  ticketFormId       String?
  customFieldValues  Json?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitor           Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignee          WorkspaceMember?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  slaPolicy         SlaPolicy?          @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  ticketForm        TicketForm?         @relation(fields: [ticketFormId], references: [id], onDelete: SetNull)
  messages          Message[]
  sharedDraft       SharedDraft?
  sideConversations SideConversation[]
  automationRuns    AutomationRun[]

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, channel])
  @@map(name: "conversations")
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  type            MessageType
  body            String
  senderId        String?
  senderName      String?
  attachments     Json?
  emailMessageId  String?     // RFC 2822 Message-ID for email threading
  mentions        String[]    // userId[] of mentioned teammates
  createdAt       DateTime    @default(now()) @map(name: "created_at")
  updatedAt       DateTime    @updatedAt @map(name: "updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map(name: "messages")
}

// ─── Canned Responses ────────────────────────────────────

model CannedResponse {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map(name: "canned_responses")
}

// ─── Knowledge Base Models ───────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  Article[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map(name: "collections")
}

model Article {
  id              String    @id @default(cuid())
  workspaceId     String
  collectionId    String?
  title           String
  slug            String
  body            String
  excerpt         String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  authorId        String
  order           Int       @default(0)
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  createdAt       DateTime  @default(now()) @map(name: "created_at")
  updatedAt       DateTime  @updatedAt @map(name: "updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId, isPublished])
  @@index([workspaceId, collectionId])
  @@map(name: "articles")
}

model HelpCenterSettings {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  title        String   @default("Help Center")
  subtitle     String?
  primaryColor String   @default("#3ECF8E")
  logoUrl      String?
  createdAt    DateTime @default(now()) @map(name: "created_at")
  updatedAt    DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map(name: "help_center_settings")
}

model AiUsageLog {
  id             String   @id @default(cuid())
  workspaceId    String
  feature        String   // "reply_suggestion", "summarize", "categorize", "suggest_articles", "sentiment"
  inputTokens    Int
  outputTokens   Int
  model          String   @default("claude-sonnet-4-5-20250929")
  conversationId String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map(name: "ai_usage_logs")
}

// ─── Automations ────────────────────────────────────────

enum AutomationTrigger {
  CONVERSATION_CREATED
  CONVERSATION_CLOSED
  MESSAGE_RECEIVED
  CONVERSATION_UNASSIGNED_FOR
  TAG_ADDED
}

enum AutomationAction {
  ASSIGN_TO
  ADD_TAG
  REMOVE_TAG
  CHANGE_STATUS
  SEND_MESSAGE
  NOTIFY_SLACK
}

model AutomationRule {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isEnabled   Boolean           @default(true)
  trigger     AutomationTrigger
  conditions  Json?             // e.g. {"tags_contain": "bug", "status": "OPEN"}
  action      AutomationAction
  actionConfig Json             // e.g. {"assigneeId": "xxx"} or {"tag": "urgent"}
  order       Int               @default(0)
  lastTriggeredAt DateTime?
  triggerCount    Int            @default(0)
  createdAt   DateTime          @default(now()) @map(name: "created_at")
  updatedAt   DateTime          @updatedAt @map(name: "updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, isEnabled])
  @@map(name: "automation_rules")
}

/// One row per rule run for one event. The unique (ruleId, eventKey) pair
/// makes a retried or duplicated event run each rule once. Rows also feed
/// the per-conversation and per-workspace rate caps.
model AutomationRun {
  id             String            @id @default(cuid())
  workspaceId    String
  ruleId         String
  conversationId String
  trigger        AutomationTrigger
  eventKey       String
  status         String // running, succeeded, failed
  error          String?
  createdAt      DateTime          @default(now()) @map(name: "created_at")
  finishedAt     DateTime?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventKey])
  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@map(name: "automation_runs")
}

// ─── AI Agents ─────────────────────────────────────────

enum AgentType {
  BUILT_IN     // Platform-provided agents (GudBot, TriageBot, etc.)
  MARKETPLACE  // Third-party agents from a future marketplace
  CUSTOM       // Self-hosted agents installed by the workspace
}

model Agent {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  type        AgentType @default(CUSTOM)
  iconUrl     String?               // Agent avatar/icon
  creatorName String?               // "Acme Inc" or developer name
  creatorUrl  String?               // Link to creator's site

  // Connections — the agent's webhook + API key
  webhookEndpointId String? @unique // The webhook this agent listens on
  apiKeyId          String? @unique // The API key this agent uses to act

  // Configuration
  config      Json?                 // Agent-specific settings (escalation rules, model prefs, etc.)
  isEnabled   Boolean   @default(true)
  priority    Int       @default(0) // Lower = runs first (for event ordering)

  installedAt DateTime  @default(now())
  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookEndpoint WebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isEnabled])
  @@map(name: "agents")
}

// ─── Webhooks ───────────────────────────────────────────

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookEndpoint {
  id          String  @id @default(cuid())
  workspaceId String
  url         String
  secret      String
  description String?
  isEnabled   Boolean @default(true)

  // Event subscriptions
  onMessageCreated       Boolean @default(true)
  onConversationCreated  Boolean @default(true)
  onConversationClosed   Boolean @default(false)
  onConversationAssigned Boolean @default(false)

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent      Agent?
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map(name: "webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String
  event        String                // "message.created", "ping", etc.
  payload      String                @db.Text
  status       WebhookDeliveryStatus @default(PENDING)
  attemptCount Int                   @default(0)
  maxAttempts  Int                   @default(6)
  nextRetryAt  DateTime?
  httpStatus   Int?
  responseBody String?               @db.Text
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime              @default(now()) @map(name: "created_at")
  updatedAt    DateTime              @updatedAt @map(name: "updated_at")
  completedAt  DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextRetryAt])
  @@index([endpointId, status])
  @@map(name: "webhook_deliveries")
}

// ─── API Keys ───────────────────────────────────────────

model ApiKey {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  keyHash     String           @unique
  keyPrefix   String
  permission  ApiKeyPermission @default(READ_WRITE)
  isEnabled   Boolean          @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now()) @map(name: "created_at")
  updatedAt   DateTime         @updatedAt @map(name: "updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?

  @@index([userId])
  @@index([workspaceId])
  @@map(name: "api_keys")
}

// ─── Slack Integration ──────────────────────────────────

model SlackIntegration {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  accessToken      String
  slackTeamName    String?
  channelId        String?
  channelName      String?
  webhookUrl       String?
  botUserId        String?
  notifyOnNew      Boolean  @default(true)
  notifyOnClose    Boolean  @default(false)
  notifyOnAssign   Boolean  @default(false)
  createdAt        DateTime @default(now()) @map(name: "created_at")
  updatedAt        DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map(name: "slack_integrations")
}

// ─── Analytics Snapshots ────────────────────────────────

model AnalyticsSnapshot {
  id                    String   @id @default(cuid())
  workspaceId           String
  date                  DateTime @db.Date
  newConversations      Int      @default(0)
  closedConversations   Int      @default(0)
  totalMessages         Int      @default(0)
  avgFirstResponseMs    Int?     // milliseconds
  avgResolutionMs       Int?     // milliseconds
  visitorCount          Int      @default(0)
  createdAt             DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
  @@map(name: "analytics_snapshots")
}

// ─── Admin Audit Log ──────────────────────────────────

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // "ban_user", "unban_user", "change_plan", "delete_workspace", "change_role"
  targetType String   // "USER" or "WORKSPACE"
  targetId   String
  metadata   Json?    // extra context (reason, old/new values)
  createdAt  DateTime @default(now()) @map(name: "created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map(name: "admin_audit_logs")
}

// ─── Company Profiles ──────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  domain      String?
  website     String?
  logoUrl     String?
  industry    String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitors  Visitor[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@map(name: "companies")
}

// ─── Custom Fields ─────────────────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  ENUM
}

model CustomField {
  id           String          @id @default(cuid())
  workspaceId  String
  name         String
  key          String
  fieldType    CustomFieldType
  entityType   String          // "customer" or "company"
  isRequired   Boolean         @default(false)
  enumOptions  String[]
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now()) @map(name: "created_at")
  updatedAt    DateTime        @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, entityType])
  @@index([workspaceId, entityType])
  @@map(name: "custom_fields")
}

// ─── Customer Events (Timeline) ────────────────────────

model CustomerEvent {
  id          String   @id @default(cuid())
  workspaceId String
  visitorId   String
  type        String   // "conversation.created", "message.sent", "customer.identified", etc.
  title       String
  metadata    Json?
  createdAt   DateTime @default(now()) @map(name: "created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitor   Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
  @@index([workspaceId, createdAt])
  @@map(name: "customer_events")
}

// ─── Customer Segments ─────────────────────────────────

model CustomerSegment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  conditions  Json     // [{ field, operator, value }]
  color       String?
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map(name: "customer_segments")
}

// ─── SLA Policies ─────────────────────────────────────

model SlaPolicy {
  id                    String   @id @default(cuid())
  workspaceId           String
  name                  String
  firstResponseMinutes  Int
  resolutionMinutes     Int
  priority              Int?     // null = default for all; 0-3 = specific priority
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now()) @map(name: "created_at")
  updatedAt             DateTime @updatedAt @map(name: "updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, priority])
  @@index([workspaceId])
  @@map(name: "sla_policies")
}

// ─── Business Hours ───────────────────────────────────

model BusinessHours {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  timezone    String   @default("UTC")
  schedule    Json     // { "monday": { "start": "09:00", "end": "17:00" }, ... }
  holidays    Json     @default("[]") // ["2026-01-01", ...]
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map(name: "business_hours")
}

// ─── Ticket Forms ─────────────────────────────────────

model TicketForm {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  fieldKeys   String[] // ordered CustomField.key values
  isDefault   Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId])
  @@map(name: "ticket_forms")
}

// ─── CSAT & Feedback ──────────────────────────────────

model SurveyConfig {
  id            String            @id @default(cuid())
  workspaceId   String
  type          SurveyType
  isEnabled     Boolean           @default(false)
  trigger       SurveyTriggerType @default(ON_CLOSE)
  delayMinutes  Int               @default(0)
  questionText  String            @default("How would you rate your experience?")
  thankYouText  String            @default("Thank you for your feedback!")
  createdAt     DateTime          @default(now()) @map(name: "created_at")
  updatedAt     DateTime          @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
  @@map(name: "survey_configs")
}

model SurveyResponse {
  id              String     @id @default(cuid())
  workspaceId     String
  conversationId  String?
  visitorId       String
  type            SurveyType
  rating          Int        // CSAT: 1-5, NPS: 0-10
  comment         String?
  assigneeId      String?    // agent who handled conversation, for per-agent breakdown
  respondedAt     DateTime   @default(now())
  createdAt       DateTime   @default(now()) @map(name: "created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, respondedAt])
  @@index([workspaceId, assigneeId, respondedAt])
  @@index([conversationId])
  @@map(name: "survey_responses")
}

// ─── Email Channel ────────────────────────────────────

model EmailChannelConfig {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  isEnabled       Boolean  @default(false)
  supportAddress  String?  // e.g. "support@acme.guddesk.com"
  forwardAddress  String?  // custom domain forwarding target
  fromName        String?  // "Acme Support"
  fromAddress     String?  // verified sender address
  signature       String?  // HTML signature for outbound replies
  autoReopen      Boolean  @default(true)
  createdAt       DateTime @default(now()) @map(name: "created_at")
  updatedAt       DateTime @updatedAt @map(name: "updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map(name: "email_channel_configs")
}

// ─── Shared Drafts ──────────────────────────────────

model SharedDraft {
  id              String   @id @default(cuid())
  conversationId  String   @unique
  body            String   @default("")
  lastEditedBy    String?  // userId
  updatedAt       DateTime @updatedAt @map(name: "updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map(name: "shared_drafts")
}

// ─── Side Conversations ─────────────────────────────

model SideConversation {
  id              String   @id @default(cuid())
  workspaceId     String
  conversationId  String
  subject         String
  createdById     String
  status          String   @default("OPEN") // OPEN | CLOSED
  participantIds  String[]
  createdAt       DateTime @default(now()) @map(name: "created_at")
  updatedAt       DateTime @updatedAt @map(name: "updated_at")

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     SideConversationMessage[]

  @@index([conversationId])
  @@index([workspaceId])
  @@map(name: "side_conversations")
}

model SideConversationMessage {
  id                  String   @id @default(cuid())
  sideConversationId  String
  senderId            String
  senderName          String?
  body                String
  createdAt           DateTime @default(now()) @map(name: "created_at")

  sideConversation SideConversation @relation(fields: [sideConversationId], references: [id], onDelete: Cascade)

  @@index([sideConversationId, createdAt])
  @@map(name: "side_conversation_messages")
}

// ─── Agent Performance Snapshots ────────────────────

model AgentPerformanceSnapshot {
  id                    String   @id @default(cuid())
  workspaceId           String
  memberId              String   // WorkspaceMember.id
  date                  DateTime @db.Date
  conversationsHandled  Int      @default(0)
  messagesCount         Int      @default(0)
  avgFirstResponseMs    Int?
  avgResolutionMs       Int?
  csatAverage           Float?
  csatCount             Int      @default(0)
  createdAt             DateTime @default(now()) @map(name: "created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([workspaceId, date])
  @@map(name: "agent_performance_snapshots")
}
